# Shared network
SHARED_NETWORK=docker-utils-shared

# Images (pinned tags)
TRAEFIK_IMAGE=traefik:v3.1
PORTAINER_IMAGE=portainer/portainer-ce:2.21.5
PGADMIN_IMAGE=dpage/pgadmin4:8.13
POSTGRES_IMAGE=postgres:16

# Routing
TRAEFIK_DASHBOARD_HOST=traefik.localhost
PORTAINER_HOST=portainer.localhost
PGADMIN_HOST=pgadmin.localhost

# Traefik dashboard auth (user:hash)
# Generate one with: ./scripts/gen-traefik-basicauth.sh admin
TRAEFIK_DASHBOARD_USERS=admin:REPLACE_WITH_HTPASSWD_HASH

# PostgreSQL
POSTGRES_USER=user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mydb
POSTGRES_DEBUG_PORT=5433

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=change-me
